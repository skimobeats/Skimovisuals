{
  "name": "skimovisuals",
  "productName": "Skimovisuals",
  "version": "0.1.0",
  "description": "Audio reactive visual creator for music videos",
  "author": "Skimo",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outdir=dist-electron",
    "build": "vite build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "44.10.2",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.skimobeats.skimovisuals",
    "productName": "Skimovisuals",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "skimo",
        "name": "Skimovisuals Project"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Skimovisuals"
    }
  }
}
